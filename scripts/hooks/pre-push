#!/bin/sh
# 推送前跑后端测试：真的有用例失败才拦住，避免把红着的代码推到远端。
# 确需绕过时用 git push --no-verify。
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

if [ -x backend/.venv/Scripts/python.exe ]; then
  PY=backend/.venv/Scripts/python.exe
elif [ -x backend/.venv/bin/python ]; then
  PY=backend/.venv/bin/python
else
  # 没有虚拟环境时不假装通过，明确提示让推送方自己决定
  echo "[pre-push] 找不到 backend/.venv，无法运行测试，请手工执行 pytest" >&2
  exit 1
fi

echo "[pre-push] 运行后端测试 backend/tests …" >&2

# 两层保护，缺一不可：
# 1) pytest 收尾要清理自己建的临时目录，工作区外没有交互确认通道，批量删除保护会
#    直接 SystemExit(1)。只对测试子进程关掉它，让 pytest 能正常收尾。
# 2) 即便这样，仍按 pytest 的汇总行判定结果，不靠退出码——别的环境若还有类似拦截，
#    「用例全过」也不会被误判成失败。
out=$(CODEBUDDY_SAFE_DELETE_ENABLED=0 "$PY" -m pytest backend/tests -q 2>&1)
status=$?
printf '%s\n' "$out"

if printf '%s\n' "$out" | grep -Eq '[0-9]+ (failed|error)'; then
  echo "[pre-push] 有用例失败，已阻止推送。确要推送请用 git push --no-verify" >&2
  exit 1
fi

if printf '%s\n' "$out" | grep -Eq '[0-9]+ passed'; then
  if [ "$status" -ne 0 ]; then
    echo "[pre-push] 用例全过，退出码 $status 来自收尾清理被拦截，按通过处理" >&2
  fi
  exit 0
fi

# 既没有失败也没有通过汇总：测试根本没跑起来，按失败处理
echo "[pre-push] 没拿到测试结果（退出码 $status），已阻止推送" >&2
exit 1
